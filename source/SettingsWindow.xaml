                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="DSH 版本管理" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}"
