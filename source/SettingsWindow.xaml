                                                        <ComboBoxItem Content="主页" Tag="Home" /><ComboBoxItem Content="常规" Tag="General" /><ComboBoxItem Content="拓展" Tag="Extensions" /><ComboBoxItem Content="核心" Tag="Core" /><ComboBoxItem Content="更新" Tag="Updates" /><ComboBoxItem Content="补丁" Tag="Patches" /><ComboBoxItem Content="关于" Tag="About" />
