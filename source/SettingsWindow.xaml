                                              DropDownOpened="DshVersionComboBox_DropDownOpened"
                                              SelectionChanged="DshVersionComboBox_SelectionChanged" />
                                    <Button x:Name="ApplyDshVersionButton" Grid.Column="1" Content="应用版本"
                                            Style="{StaticResource SettingsAccentActionButtonStyle}" IsEnabled="False"
                                            Click="ApplyDshVersionButton_Click" />
                                </Grid>
                                <InfoBar x:Name="DshVersionManagementInfoBar" IsClosable="False" IsOpen="False" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="DSH 目录" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="需包含 node_modules\@deepseek-ai\dsh\lib\bin.js。" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="DshPathBox"
                                        PlaceholderText="选择 DSH 安装目录"
