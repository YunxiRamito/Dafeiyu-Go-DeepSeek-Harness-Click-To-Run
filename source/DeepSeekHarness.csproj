<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeepSeekHarnessLauncher</RootNamespace>
    <AssemblyName>DeepSeek Harness</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>DeepSeekHarness.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>1.5.2</Version>
    <AssemblyVersion>1.5.2.0</AssemblyVersion>
    <FileVersion>1.5.2.0</FileVersion>
    <Product>Dafeiyu-Go</Product>
    <Title>Dafeiyu-Go</Title>
    <AssemblyTitle>Dafeiyu-Go</AssemblyTitle>
    <Authors>Deepseek/KitamaruRamito</Authors>
    <Company>高性能萝卜子鲸鲸有限公司</Company>
    <Description>大肥鱼Go，面向 DeepSeek Harness 的 Windows 安装、启动与管理工具。</Description>
    <Copyright>Copyright © 2026 Deepseek/KitamaruRamito</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Compile Remove="Program.cs" />
    <Compile Remove="RuntimeBootstrap.cs" />
    <EmbeddedResource Include="DeepSeekHarness.ico" LogicalName="AppIcon.ico" />

    <!-- .dym 备份包用的是真 7z 格式,所以带上一个 7zr(588 KB,单文件、公开领域) -->
    <EmbeddedResource Include="Backup\7zr.exe" />
    <Content Include="DeepSeekHarness.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="assets\DeepSeek-icon.png" LogicalName="AppIcon.png" />
    <Content Include="assets\DeepSeek-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\donate-alipay.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\donate-wechat.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\SettingsNavIcons\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\plugin-placeholder.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\SettingsNavIconsWin10\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\SettingsNavIconsWin10Dark\*.svg" CopyToOutputDirectory="PreserveNewest" />

    <!-- 自带的用量统计插件：随包发出去，一键安装就是把它复制到 <dshRoot>\plugins\ -->
    <Content Include="assets\dsh-token-stats\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>
</Project>
