                        </Border>

                        <!-- Token 用量与余额：用量读自带插件 dsh-token-stats 写的 usage.jsonl，
                             余额走 BalanceSupport；卡片上只留「余额 + 今日」两行，其余看图。 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="HomeUsageTitleText"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Token 用量与余额" />
                                    <ComboBox
                                        x:Name="HomeUsageRangeBox"
                                        Grid.Column="1"
                                        MinWidth="112"
                                        SelectionChanged="HomeUsageRangeBox_SelectionChanged"
                                        Style="{StaticResource SettingsComboBoxStyle}">
                                        <ComboBoxItem
                                            Content="近 7 天"
                                            Tag="7" />
                                        <ComboBoxItem
                                            Content="近 15 天"
                                            Tag="15" />
                                        <ComboBoxItem
                                            Content="近 30 天"
                                            Tag="30" />
                                    </ComboBox>
                                    <Button
                                        x:Name="HomeUsageRefreshButton"
                                        Grid.Column="2"
                                        Content="刷新"
                                        Click="HomeUsageRefreshButton_Click"
                                        Style="{StaticResource SettingsCompactButtonStyle}" />
                                </Grid>
                                <StackPanel
                                    x:Name="HomeUsageHost"
                                    Spacing="4" />

                                <!-- 两张图都是 Canvas 自己画的：WinUI 3 没有自带图表控件
                                     （Windows Community Toolkit 8.x 里也没有图，老的
                                     DataVisualization 包已下架），自己画就不用为几张柱子
                                     给 11MB 的包塞进 SkiaSharp。 -->
                                <StackPanel
                                    x:Name="HomeUsageChartPanel"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="柱 = Token 用量 · 线 = 花费金额（估算）" />
                                        <TextBlock
                                            x:Name="HomeUsageChartPeakText"
                                            Grid.Column="1"
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                    </Grid>
                                    <Canvas
                                        x:Name="HomeUsageChart"
                                        Height="104"
                                        Background="Transparent"
                                        PointerExited="HomeUsageChart_PointerExited"
                                        PointerMoved="HomeUsageChart_PointerMoved"
                                        SizeChanged="HomeUsageChart_SizeChanged" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="HomeUsageHintText"
                                    Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="HomeUsageInstallButton"
                                    Content="安装用量统计插件"
                                    Click="HomeUsageInstallButton_Click"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="快捷入口" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="HomePluginsButton"
                                        Content="插件市场"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        x:Name="HomeSkillsButton"
                                        Content="技能市场"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        x:Name="HomeComponentsButton"
                                        Content="组件"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        x:Name="HomeUpdatesButton"
                                        Content="更新"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 常规 -->
                    <StackPanel
                        x:Name="GeneralPage"
                        Spacing="16">
                        <TextBlock
                            Style="{StaticResource SettingsPageTitleTextStyle}"
                            Text="常规" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="启动端口" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="DSH 服务的监听端口。" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="14">
                                        <RadioButton
                                            x:Name="RandomPortRadio"
                                            Content="随机端口"
                                            GroupName="StartupPortMode"
                                            Tag="Random"
                                            Checked="PortModeRadio_Checked" />
                                        <RadioButton
                                            x:Name="FixedPortRadio"
                                            Content="固定端口"
                                            GroupName="StartupPortMode"
                                            Tag="Fixed"
                                            Checked="PortModeRadio_Checked" />
                                        <RadioButton
                                            x:Name="DefaultPortRadio"
                                            Content="默认 3080"
                                            GroupName="StartupPortMode"
                                            Tag="Default"
                                            IsChecked="True"
                                            Checked="PortModeRadio_Checked" />
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    x:Name="FixedPortRow"
                                    ColumnSpacing="16"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="固定端口" />
                                    <NumberBox
                                        x:Name="FixedPortBox"
                                        Grid.Column="1"
                                        Minimum="1024"
                                        Maximum="65535"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        MinWidth="104" Width="104" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Value="8787" />
                                </Grid>

                                <InfoBar
                                    x:Name="DefaultPortWarning"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Message="使用默认端口可能导致您的 DSH 服务遭受外部攻击。请确认您未使用公网 IP，并确定局域网内无威胁设备。"
                                    Severity="Warning"
                                    Title="安全提示" />
                                <InfoBar
                                    x:Name="PortChangeInfoBar"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Message="操作将会在下次启动服务时生效。"
                                    Severity="Success"
                                    Title="已保存" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="开机自启动" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="开机自动启动。" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="StartWithWindowsToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsOn="True" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="静默启动" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="启动 DSH 时是否自动打开网页。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="SilentStartComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBoxItem Content="全部" Tag="All" />
                                    <ComboBoxItem Content="仅开机自启" Tag="StartupOnly" />
                                    <ComboBoxItem Content="关闭" Tag="Off" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="在线引擎" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="更新与在线插件的网络入口。" />
                                    </StackPanel>
                                    <Button
                                        x:Name="AcceleratorAdvancedToggle"
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource SettingsCompactButtonStyle}"
                                        ToolTipService.ToolTip="选加速源、看各源延迟">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                x:Name="AcceleratorAdvancedChevron"
                                                FontSize="10"
                                                Glyph="&#xE70D;" />
                                            <TextBlock Text="高级设置" />
                                        </StackPanel>
                                    </Button>
                                    <ComboBox
                                        x:Name="UpdateSourceComboBox"
                                        Grid.Column="2"
                                        MinWidth="180"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <ComboBoxItem
                                            x:Name="UpdateSourceAcceleratedItem"
                                            Content="大陆 CDN 加速"
                                            Tag="Accelerated" />
                                        <ComboBoxItem
                                            x:Name="UpdateSourceCustomItem"
                                            Content="自定义"
                                            Tag="Custom"
                                            Visibility="Collapsed" />
                                        <ComboBoxItem Content="官方源" Tag="Official" />
                                    </ComboBox>
                                </Grid>

                                <StackPanel
                                    x:Name="AcceleratorAdvancedPanel"
                                    Spacing="10"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="AcceleratorAdvancedHint"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="自动：每次运行都测一遍延迟，挑最快的用。" />
                                    <RadioButtons
                                        x:Name="AcceleratorSourceSelector"
                                        SelectionChanged="AcceleratorSourceSelector_SelectionChanged">
                                        <RadioButton
                                            x:Name="AcceleratorAutoRadio"
                                            Content="自动（推荐）"
                                            Tag="Auto" />
                                        <RadioButton x:Name="AcceleratorGhproxyRadio" Tag="ghproxy" />
                                        <RadioButton x:Name="AcceleratorGhProxyRadio" Tag="gh-proxy" />
                                        <RadioButton x:Name="AcceleratorGhfastRadio" Tag="ghfast" />
                                        <RadioButton x:Name="AcceleratorJsdelivrRadio" Tag="jsdelivr" />
                                    </RadioButtons>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="AcceleratorLatencyText"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="还没测速。" />
                                        <Button
                                            x:Name="AcceleratorLatencyButton"
                                            Grid.Column="1"
                                            Content="重新测速"
                                            Style="{StaticResource SettingsCompactButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="插件来源" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="插件目录与安装包的来源。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="PluginSourceComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="200" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="代理设置" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="启动器与在线服务是否走代理。不影响 DSH 本体。" />
                                </StackPanel>
                                <!-- 故意不写 SelectedIndex：写死的 0 会在首次布局时把选中项
                                     拽回「不使用代理」，紧接着 SelectionChanged 就把刚读出来的
                                     代理设置覆盖成直连。选中项统一由代码按配置设置。 -->
                                <RadioButtons x:Name="ProxyModeSelector">
                                    <RadioButton
                                        Content="不使用代理"
                                        Tag="None" />
                                    <RadioButton
                                        Content="使用系统代理"
                                        Tag="System" />
                                    <RadioButton
                                        Content="使用自定义代理"
                                        Tag="Custom" />
                                </RadioButtons>
                                <ContentControl
                                    x:Name="ProxyCustomPanel"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="False">
                                    <StackPanel Spacing="12">
                                    <RadioButtons
                                        x:Name="ProxyProtocolSelector"
                                        Header="代理协议"
                                        MaxColumns="3">
                                        <RadioButton
                                            Content="http 代理（推荐）"
                                            Tag="Http" />
                                        <RadioButton
                                            Content="https 代理（代理端 TLS）"
                                            Tag="Https" />
                                        <RadioButton
                                            Content="socks5"
                                            Tag="Socks5" />
                                    </RadioButtons>
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="本地代理选 http；https 走 TLS。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ProxyHostBox"
                                            Header="代理地址"
                                            PlaceholderText="127.0.0.1"
                                            Text="127.0.0.1" />
                                        <NumberBox
                                            x:Name="ProxyPortBox"
                                            Grid.Column="1"
                                            Header="端口"
                                            Maximum="65535"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="7890"
                                            Width="128" />
                                    </Grid>
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </Border>

                        <!-- 数据备份：导出/导入都挂在这一张卡上，点了才展开自己的面板，
                             免得常规页为了一个偶尔用一次的功能再长出一截。 -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="数据备份" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="把配置、技能、插件打包成一个 .dym 文件带走。换台机器或者重装之前先备一份。" />
                                    </StackPanel>
                                    <Button
                                        x:Name="BackupExportButton"
                                        Grid.Column="1"
                                        Click="BackupExportButton_Click"
                                        Content="导出数据"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        x:Name="BackupImportButton"
                                        Grid.Column="2"
                                        Click="BackupImportButton_Click"
                                        Content="导入数据"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                </Grid>

                                <InfoBar
                                    x:Name="BackupInfoBar"
                                    IsClosable="True"
                                    IsOpen="False" />

                                <!-- 导出 -->
                                <StackPanel
                                    x:Name="BackupExportPanel"
                                    Spacing="10"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="要带走哪些" />
                                        <StackPanel
                                            x:Name="BackupExportGroupsHost"
                                            Spacing="2" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="BackupExportTargetBox"
                                            Style="{StaticResource SettingsPathBoxStyle}" />
                                        <Button
                                            x:Name="BackupExportFolderButton"
                                            Grid.Column="1"
                                            Click="BackupExportFolderButton_Click"
                                            Content="选择文件夹"
                                            Style="{StaticResource SettingsActionButtonStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BackupExportStartButton"
                                            Click="BackupExportStartButton_Click"
                                            Content="开始导出"
                                            Style="{StaticResource SettingsAccentActionButtonStyle}" />
                                        <ProgressBar
                                            x:Name="BackupExportProgress"
                                            Grid.Column="1"
                                            Maximum="100"
                                            Minimum="0"
                                            VerticalAlignment="Center"
                                            Value="0" />
                                        <Button
                                            x:Name="BackupExportCancelButton"
                                            Grid.Column="2"
                                            Click="BackupCancel_Click"
                                            Content="取消"
                                            Style="{StaticResource SettingsCompactButtonStyle}"
                                            Visibility="Collapsed" />
