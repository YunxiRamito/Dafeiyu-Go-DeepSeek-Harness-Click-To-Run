<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>SYSLIB0014;CA1416</NoWarn>
    <RuntimeDetectionSourceRoot Condition="'$(RuntimeDetectionSourceRoot)' == ''">../../source</RuntimeDetectionSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RuntimeDetectionSourceRoot)/ComponentService.cs" Link="ComponentService.cs" />
    <Compile Include="$(RuntimeDetectionSourceRoot)/WindowsAppRuntimeDetector.cs" Link="WindowsAppRuntimeDetector.cs" />
  </ItemGroup>
</Project>
