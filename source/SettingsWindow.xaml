                                        <ComboBox x:Name="DeveloperFeedbackCategoryFilter" MinWidth="0" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="DeveloperFeedbackFilter_SelectionChanged" AutomationProperties.Name="反馈类别" Style="{StaticResource SettingsComboBoxStyle}">
