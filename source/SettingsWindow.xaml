                                    <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="通知静音" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}" Text="关闭提示音，继续显示通知。" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NotificationMutedToggle" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="通知静音" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid ColumnSpacing="16" MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="更新提醒" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}" Text="启动器、DSH 和安装器的新版本。" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="UpdateReminderToggle" Grid.Column="1" HorizontalAlignment="Right" IsOn="True" VerticalAlignment="Center" AutomationProperties.Name="更新提醒" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid ColumnSpacing="16" MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="插件更新提醒" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}" Text="插件的新版本及安装结果。" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PluginUpdateReminderToggle" Grid.Column="1" HorizontalAlignment="Right" IsOn="True" VerticalAlignment="Center" AutomationProperties.Name="插件更新提醒" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid ColumnSpacing="16" MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="充值提醒" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}" Text="余额增加时提醒。" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RechargeReminderToggle" Grid.Column="1" HorizontalAlignment="Right" IsOn="True" VerticalAlignment="Center" AutomationProperties.Name="充值提醒" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="今日消费提醒" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}" Text="今日消费达到所选金额。" />
