            </ContentDialog.Resources>
            <ScrollViewer
                MaxHeight="480"
                VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="PluginDetailTitle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="dsh-plugin-store"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PluginDetailAuthor"
                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                            Text="0xKcyzz · 0xKcyzz/dsh-plugin-store" />
                    </StackPanel>
                    <Button
                        x:Name="ClosePluginDetailButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                                                       
                        Style="{StaticResource SettingsIconButtonStyle}"
                        ToolTipService.ToolTip="关闭" Click="ClosePluginDetail_Click">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Spacing="12">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Stars 312" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="TypeScript" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="MIT" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="最近更新 2026-09-18" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="PluginDetailDescription"
                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                        Text="插件详情。"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="插件与依赖会以第三方代码的身份在 DSH 里运行，请确认来源可信后再安装。"
                        Severity="Informational"
                        Title="安装来自 GitHub 的第三方插件" />
                    <!-- 中文翻译：只翻文档，不动插件源码、机器错误码和运行时字符串。 -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="TranslatePluginButton"
                            AutomationProperties.Name="把插件文档翻译成中文"
                            Content="翻译成中文"
                                                               
                            Style="{StaticResource SettingsActionButtonStyle}"  Click="TranslatePluginDetail_Click"/>
                        <Button
                            x:Name="TogglePluginOriginalButton"
                            AutomationProperties.Name="在中文译文和原文之间切换"
                            Content="查看原文"
                                                              
                            Visibility="Collapsed"
                            Style="{StaticResource SettingsActionButtonStyle}"  Click="TogglePluginOriginal_Click"/>
                    </StackPanel>
                    <InfoBar
                        x:Name="PluginTranslateInfoBar"
                        IsClosable="False"
                        IsOpen="False" />
                    <TextBlock
                        x:Name="PluginTranslateBody"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenPluginRepositoryButton"
                        Content="打开 GitHub 仓库"
                                                          
                        Style="{StaticResource SettingsActionButtonStyle}"  Click="OpenPluginRepository_Click"/>
                    <Button
                        x:Name="CopyPluginConfigButton"
                        Content="复制配置方式"
                                                      
                        Style="{StaticResource SettingsActionButtonStyle}"  Click="CopyPluginConfig_Click"/>
                    <Button
                        x:Name="InstallOnlinePluginButton"
                        Content="安装"
                                                         
                        Style="{StaticResource SettingsAccentActionButtonStyle}"  Click="InstallDetailPlugin_Click"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </ContentDialog>

        <!-- 在线技能详情卡片 -->
        <ContentDialog
            x:Name="SkillDetailDialog"
            Grid.RowSpan="2"
            PrimaryButtonText=""
            SecondaryButtonText=""
            CloseButtonText="">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer
                MaxHeight="480"
                VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="SkillDetailTitle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="beautify-github-readme"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SkillDetailAuthor"
                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                            Text="oil-oil · oil-oil/beautify-github-readme" />
                    </StackPanel>
                    <Button
                        x:Name="CloseSkillDetailButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                                                      
                        Style="{StaticResource SettingsIconButtonStyle}"
                        ToolTipService.ToolTip="关闭" Click="CloseSkillDetail_Click">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Spacing="12">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailStarsText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Stars 0" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailCategoryText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="其他" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailLanguageText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="未标注" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailLicenseText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="未标注" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailPushedText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="最近更新 -" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="SkillDetailDescription"
                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                        Text="技能简介。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SkillDetailPathText"
                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                        Text="技能目录：-" />
                    <!-- 技能集：同仓库的成员列在这里，点一个就切到它的详情。 -->
                    <StackPanel
                        x:Name="SkillDetailMembersPanel"
                        Spacing="2"
                        Visibility="Collapsed" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="技能是给 Agent 看的指令，装上以后模型会照着它执行。请确认来源可信后再安装。"
                        Severity="Informational"
                        Title="安装来自 GitHub 的第三方技能" />
                    <!-- 中文翻译：只翻自然语言，代码/路径/命令原样保留；原文永远不动。 -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="TranslateSkillButton"
                            AutomationProperties.Name="把技能正文翻译成中文"
                            Content="翻译成中文"
                                                              
                            Style="{StaticResource SettingsActionButtonStyle}"  Click="TranslateSkillDetail_Click"/>
                        <Button
                            x:Name="ToggleSkillOriginalButton"
                            AutomationProperties.Name="在中文译文和原文之间切换"
                            Content="查看原文"
                                                             
                            Visibility="Collapsed"
                            Style="{StaticResource SettingsActionButtonStyle}"  Click="ToggleSkillOriginal_Click"/>
                    </StackPanel>
                    <InfoBar
                        x:Name="SkillTranslateInfoBar"
                        IsClosable="False"
                        IsOpen="False" />
                    <TextBlock
                        x:Name="SkillTranslateBody"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenSkillRepositoryButton"
                        Content="打开 GitHub 仓库"
                                                               
                        Style="{StaticResource SettingsActionButtonStyle}"  Click="OpenDetailSkillRepository_Click"/>
                    <Button
                        x:Name="InstallDetailSkillButton"
                        Content="安装"
                                                        
                        Style="{StaticResource SettingsAccentActionButtonStyle}"  Click="InstallDetailSkill_Click"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </ContentDialog>

        <!-- 公告编辑：开发者页新增 / 修改一条公告 -->
        <ContentDialog
            x:Name="AnnouncementEditDialog"
            Grid.RowSpan="2"
            DefaultButton="Primary"
            PrimaryButtonText="保存"
            SecondaryButtonText="取消"
            Title="公告">
            <StackPanel
                Width="440"
                Spacing="10">
                <TextBox
                    x:Name="AnnouncementTitleBox"
                    Header="标题"
                    PlaceholderText="一句话说清这次改了什么" />
                <TextBox
                    x:Name="AnnouncementBodyBox"
                    Height="120"
                    AcceptsReturn="True"
                    Header="正文"
                    PlaceholderText="发生了什么、影响谁、要做什么"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="AnnouncementTagBox"
                        HorizontalAlignment="Stretch"
                        Header="标签"
                        SelectedIndex="0">
                        <ComboBoxItem Content="更新" />
                        <ComboBoxItem Content="提醒" />
                        <ComboBoxItem Content="重要" />
                        <ComboBoxItem Content="活动" />
                        <ComboBoxItem Content="公告" />
                    </ComboBox>
                    <TextBox
                        x:Name="AnnouncementDateBox"
                        Grid.Column="1"
                        Header="日期"
                        PlaceholderText="2026-09-27" />
                    <CheckBox
                        x:Name="AnnouncementPinnedBox"
                        Grid.Column="2"
                        Margin="0,26,0,0"
                        Content="置顶" />
                </Grid>
                <TextBox
                    x:Name="AnnouncementUrlBox"
                    Header="详情链接（可空）"
                    PlaceholderText="https://github.com/..." />
            </StackPanel>
        </ContentDialog>

        <!-- 浮动的 GitHub Token 提示：目录接口被限流时出现 -->
        <Grid
            Grid.Row="1"
            Margin="12"
            VerticalAlignment="Bottom">
            <InfoBar
                x:Name="GitHubTokenPromptInfoBar"
                IsClosable="False"
                IsOpen="False"
                Message="您需要写入 GitHub Token 以获取更多内容。"
                Severity="Informational"
                Title="GitHub 接口配额已用完">
                <InfoBar.ActionButton>
                    <Button
                                                     
                        Content="立即填写"  Click="FillGitHubToken_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</Window>

