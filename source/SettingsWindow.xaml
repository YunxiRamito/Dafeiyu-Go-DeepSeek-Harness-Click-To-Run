        <Border
            x:Name="SettingsSearchPanel"
            Grid.Row="1"
            Width="520"
            MaxHeight="440"
            Margin="0,6,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="SettingsSearchResults"
                    Grid.Row="0"
                    MaxHeight="380"
                    Padding="4,6"
                    IsItemClickEnabled="True"
                                                               
                    ItemTemplate="{StaticResource SettingsSearchSuggestionTemplate}"
                    SelectionMode="Single"  ItemClick="SettingsSearchResults_ItemClick"/>
                <!-- 命中数放面板底部：有多少条就显示多少条；没有结果时不画分隔线 -->
                <Border
                    x:Name="SettingsSearchFooter"
                    Grid.Row="1"
                    Padding="12,7"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        x:Name="SettingsSearchHint"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="没有匹配项" />
                </Border>
