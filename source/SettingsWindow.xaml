<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeepSeekHarnessLauncher.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DeepSeekHarnessLauncher"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="Dafeiyu-Go 设置">

    <Grid
        x:Name="SettingsRoot"
        MinWidth="800"
        MinHeight="560"
        Background="Transparent">
        <Grid.Resources>
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
            <Thickness x:Key="NavigationViewItemButtonMargin">4,1,4,1</Thickness>

            <Style x:Key="SettingsPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsPageDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="SettingsRowGridStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="ColumnSpacing" Value="24" />
            </Style>

            <Style x:Key="SettingsRowTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsAccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsCompactButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsTagPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsStatusPillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <!-- 跟着窗框风格走：Win11 圆角 4，Win10 直角（见 CornerRadiusHelper） -->
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="SettingsNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Width" Value="104" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsPathBoxStyle" TargetType="TextBox">
                <Setter Property="MinWidth" Value="300" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 插件卡片：本地 / 在线 / 官方推荐共用。标题过长可横向滚动，
                 简介固定两行并省略，按钮行贴在卡片底部，同一行卡片高度齐平。 -->
            <DataTemplate x:Key="PluginCardTemplate" x:DataType="local:PluginCardItem">
                <Border
                    MinHeight="196"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 圆形图标：有图标显示图标，没有则露出 GitHub 默认标记 -->
                                <Grid
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <Image
                                        Width="15"
                                        Height="15"
                                        Source="ms-appx:///assets/plugin-placeholder.svg" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush
                                                ImageSource="{x:Bind IconSource}"
                                                Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <ScrollViewer
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                </ScrollViewer>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind StarsVisibility}">
                                    <FontIcon FontSize="12" Glyph="&#xE735;" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Stars}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Height="34"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <Border
                                    Background="{x:Bind StatusBackground, Mode=OneWay}"
                                    Style="{StaticResource SettingsStatusPillStyle}"
                                    Visibility="{x:Bind StatusVisibility}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind StatusForeground, Mode=OneWay}"
                                        Text="{x:Bind Status}" />
                                </Border>
                                <Border Style="{StaticResource SettingsTagPillStyle}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag1}"
                                        Visibility="{x:Bind Tag1Visibility}" />
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsTagPillStyle}"
                                    Visibility="{x:Bind Tag2Visibility}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag2}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Meta}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0">
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind LocalActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Tag="{x:Bind}"
                                    Style="{StaticResource SettingsIconButtonStyle}"
                                    Click="OpenPluginFolder_Click"
                                    ToolTipService.ToolTip="打开插件目录">
                                    <SymbolIcon Symbol="Folder" />
                                </Button>
                                <Button
                                    Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind CheckEnabled}"
                                    MinWidth="0"
                                    Click="CheckPluginUpdate_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}"
                                    ToolTipService.ToolTip="手动链接的插件不参与更新检查" />
                                <Button
                                    Content="卸载"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="UninstallPlugin_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                            </Grid>
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind OnlineActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Content="查看详情"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="ShowPluginDetail_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                                <Grid
                                    Grid.Column="1"
                                    RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="0"
                                        Tag="{x:Bind}"
                                        Click="InstallOnlinePlugin_Click"
                                        IsEnabled="{x:Bind PrimaryEnabled, Mode=OneWay}"
                                        Style="{StaticResource SettingsAccentActionButtonStyle}"
                                        Height="32" />
                                        <ProgressBar
                                            Grid.Row="1"
                                            Height="3"
                                            HorizontalAlignment="Stretch"
                                            Maximum="100"
                                            CornerRadius="1"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 技能卡片：本地技能 / 在线技能市场共用。技能没有插件那种依赖状态，
                 卡片上只留「打开目录 / 启停 / 删除」或「详情 / 安装」两组按钮。 -->
            <DataTemplate x:Key="SkillCardTemplate" x:DataType="local:SkillCardItem">
                <Border
                    MinHeight="196"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <Image
                                        Width="15"
                                        Height="15"
                                        Source="ms-appx:///assets/plugin-placeholder.svg" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush
                                                ImageSource="{x:Bind IconSource}"
                                                Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <ScrollViewer
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                </ScrollViewer>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind StarsVisibility}">
                                    <FontIcon FontSize="12" Glyph="&#xE735;" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Stars}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Height="34"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <Border
                                    Background="{x:Bind StatusBackground, Mode=OneWay}"
                                    Style="{StaticResource SettingsStatusPillStyle}"
                                    Visibility="{x:Bind StatusVisibility}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind StatusForeground, Mode=OneWay}"
                                        Text="{x:Bind Status}" />
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsTagPillStyle}"
                                    Visibility="{x:Bind Tag1Visibility}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag1}" />
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsTagPillStyle}"
                                    Visibility="{x:Bind Tag2Visibility}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag2}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Meta}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0">
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind LocalActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Tag="{x:Bind}"
                                    Style="{StaticResource SettingsIconButtonStyle}"
                                    Click="OpenSkillFolder_Click"
                                    ToolTipService.ToolTip="打开技能目录">
                                    <SymbolIcon Symbol="Folder" />
                                </Button>
                                <Button
                                    Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind PrimaryEnabled, Mode=OneWay}"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="CheckSkillUpdate_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}"
                                    ToolTipService.ToolTip="和在线目录对比最近提交时间" />
                                <Button
                                    Content="启停"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="ToggleSkill_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}"
                                    ToolTipService.ToolTip="停用会把 SKILL.md 改名成 SKILL.md.disabled" />
                                <Button
                                    Content="删除"
                                    Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="DeleteSkill_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                            </Grid>
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind OnlineActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Content="查看详情"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="ShowSkillDetail_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                                <Grid
                                    Grid.Column="1"
                                    RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="0"
                                        Tag="{x:Bind}"
                                        Click="InstallSkill_Click"
                                        IsEnabled="{x:Bind PrimaryEnabled, Mode=OneWay}"
                                        Style="{StaticResource SettingsAccentActionButtonStyle}"
                                        Height="32" />
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="3"
                                        HorizontalAlignment="Stretch"
                                        Maximum="100"
                                        CornerRadius="1"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}"
                                        Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 开发者管理：推荐条目的一行。左侧序号与信息，右侧排序与增删。 -->
            <DataTemplate x:Key="DeveloperEntryTemplate" x:DataType="local:DeveloperEntryCard">
                <Border
                    Margin="0,0,0,8"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MinWidth="22"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Order}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Click="DeveloperMoveUp_Click"
                            Style="{StaticResource SettingsIconButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="上移">
                            <FontIcon FontSize="12" Glyph="&#xE74A;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Click="DeveloperMoveDown_Click"
                            Style="{StaticResource SettingsIconButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="下移">
                            <FontIcon FontSize="12" Glyph="&#xE74B;" />
                        </Button>
                        <Button
                            Grid.Column="4"
                            Click="DeveloperEdit_Click"
                            Style="{StaticResource SettingsCompactButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="改名称、说明与备注">
                            编辑
                        </Button>
                        <Button
                            Grid.Column="5"
                            Click="DeveloperRemove_Click"
                            Style="{StaticResource SettingsCompactButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="从推荐列表移除">
                            移除
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 主页公告条：标签 + 日期 + 标题 + 一行正文 -->
            <DataTemplate x:Key="HomeAnnouncementTemplate" x:DataType="local:AnnouncementItem">
                <Border
                    Margin="0,0,0,8"
                    Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource SettingsTagPillStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Text="{x:Bind TagOrFallback}" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Date}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                            Text="{x:Bind Summary}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <StackPanel
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <Image
                    Width="20"
                    Height="20"
                    Source="ms-appx:///assets/DeepSeek-icon.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Dafeiyu-Go 设置" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="0"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.28" />

        <NavigationView
            x:Name="SettingsNavigationView"
            Grid.Row="1"
            CompactPaneLength="52"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="208"
            PaneDisplayMode="Left"
            SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="主页"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="GeneralNavItem"
                    Content="常规"
                    Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PluginsNavItem"
                    Content="插件"
                    Tag="Plugins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SkillsNavItem"
                    Content="技能"
                    Tag="Skills">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ComponentsNavItem"
                    Content="组件"
                    Tag="Components">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ThemeNavItem"
                    Content="主题"
                    Tag="Theme">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ApiNavItem"
                    Content="API"
                    Tag="Api">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
