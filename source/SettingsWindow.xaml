                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="余额提醒" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}" Text="余额低于所选金额，回升后重新触发。" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox x:Name="Balance20CheckBox" Content="¥20" MinWidth="0" IsChecked="True" />
                                        <CheckBox x:Name="Balance10CheckBox" Content="¥10" MinWidth="0" IsChecked="True" />
                                        <CheckBox x:Name="Balance5CheckBox" Content="¥5" MinWidth="0" IsChecked="True" />
                                        <CheckBox x:Name="Balance1CheckBox" Content="¥1" MinWidth="0" IsChecked="True" />
                                    </StackPanel>
                                    <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="BalanceCustomCheckBox" MinWidth="0" VerticalAlignment="Center" Content="自定义金额" IsChecked="True" />
                                        <NumberBox x:Name="BalanceCustomBox" Grid.Column="1" VerticalAlignment="Center" Minimum="0.01" SmallChange="1" SpinButtonPlacementMode="Compact" Value="50" AutomationProperties.Name="自定义余额提醒金额" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 服务 -->
                    <StackPanel
                        x:Name="ServicePage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="当前服务状态" />
                                    <TextBlock
                                        x:Name="ServiceStatusText"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="正在运行" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="RestartServiceButton"
                                        Content="重启服务"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
