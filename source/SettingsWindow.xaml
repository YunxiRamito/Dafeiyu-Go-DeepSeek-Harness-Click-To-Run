                                        Text="" />
                                    <Button
                                        Grid.Column="1"
                                                                        
                                        Content="浏览"
                                        Style="{StaticResource SettingsCompactButtonStyle}"  Click="BrowseDshDirectory_Click"/>
                                </Grid>
                                <InfoBar
                                    x:Name="NextServiceStartInfoBar"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Message="选项将在下次启动服务时启用。"
                                    Severity="Informational"
                                    Title="已保存" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="Node 路径" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="启动 DSH 用的 node.exe。" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="NodePathBox"
                                        PlaceholderText="选择用于启动服务的 node.exe"
                                        MinWidth="300" Height="32" HorizontalAlignment="Stretch" IsReadOnly="True" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                        Text="" />
                                    <Button
                                        Grid.Column="1"
                                                                          
                                        Content="浏览"
                                        Style="{StaticResource SettingsCompactButtonStyle}"  Click="BrowseNodeExecutable_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="重新检测环境" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="重新查找 DSH、Node 与端口。" />
                                </StackPanel>
                                <Button
                                    x:Name="RecheckEnvironmentButton"
                                    Grid.Column="1"
                                    Content="重新检测"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- 插件 -->
                    <StackPanel
                        x:Name="PluginsPage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <InfoBar
                            x:Name="PluginActionInfoBar"
                            IsClosable="False"
                            IsOpen="False" />
                        <StackPanel x:Name="PluginInstallProgressPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="PluginInstallProgressText" TextWrapping="Wrap" />
                            <ProgressBar x:Name="PluginInstallProgressBar" Maximum="100" Height="6" IsIndeterminate="True" />
                        </StackPanel>
                        <!-- 粘贴 GitHub 仓库链接直接装：整仓走官方 dsh plugin add，
                             装完 base bundle 的热加载自动挂上，不用重启；只有覆盖同名包才要重启 -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox
                                    x:Name="PluginLinkBox"
                                    PlaceholderText="粘贴 GitHub 仓库链接或 owner/repo（支持 #ref），也可以填 github:owner/repo、tarball 直链、本地绝对路径"
                                    QueryIcon="Link" />
                                <Button
                                    x:Name="InstallPluginFromLinkButton"
                                    Grid.Column="1"
                                    Click="InstallPluginFromLink_Click"
                                    Content="安装插件"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    x:Name="RestartDshFromPluginButton"
                                    Grid.Column="2"
                                    Click="RestartDshFromPlugin_Click"
                                    Content="重启 DSH"
                                    Style="{StaticResource SettingsAccentActionButtonStyle}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                Text="装完 DSH 会自动热加载，无需重启；只有覆盖已加载的同名插件时才需要重启。"
                                TextWrapping="Wrap" />
                        </StackPanel>

