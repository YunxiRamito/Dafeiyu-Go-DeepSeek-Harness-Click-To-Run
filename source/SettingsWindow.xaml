                                        FontWeight="SemiBold"
                                        Text="-" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
