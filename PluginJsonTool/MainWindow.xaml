<Window
    x:Class="DshPluginJsonTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DSH 插件 JSON 生成器">
    <Grid
        x:Name="RootGrid"
        Padding="24"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="OnRootLoaded"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="12">
            <FontIcon
                FontSize="24"
                Glyph="&#xE8B7;"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="DSH 插件 JSON 生成器" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="GitHub 仓库解析与 featured-plugins.json 输出" />
            </StackPanel>
        </StackPanel>

        <Grid
            Grid.Row="1"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="380" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="仓库" />
                        <TextBox
                            x:Name="RepositoryInput"
                            AcceptsReturn="True"
                            MinHeight="132"
                            PlaceholderText="owner/repo 或 https://github.com/owner/repo"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="每行一个仓库；可在末尾追加 | 推荐说明。" />
                    </StackPanel>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <ToggleSwitch
                                x:Name="ProxyToggle"
                                Header="使用自定义代理"
                                Toggled="OnProxyToggled" />

                            <Grid
                                x:Name="ProxyControls"
                                ColumnSpacing="10"
                                RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="108" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox
                                    x:Name="ProxyTypeBox"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Header="代理类型"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="HTTP" Tag="Http" />
                                    <ComboBoxItem Content="HTTPS" Tag="Https" />
                                    <ComboBoxItem Content="SOCKS5" Tag="Socks5" />
                                </ComboBox>
                                <TextBox
                                    x:Name="ProxyHostBox"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Header="地址"
                                    PlaceholderText="127.0.0.1" />
                                <NumberBox
                                    x:Name="ProxyPortBox"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Header="端口"
                                    Maximum="65535"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="7890" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="关闭时直连；启用后仅本工具的出网请求使用该代理。" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="OutputModeBox"
                            Grid.Column="0"
                            Header="输出格式"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnOutputModeChanged">
                            <ComboBoxItem Content="完整推荐列表" Tag="List" />
                            <ComboBoxItem Content="后台单条导入" Tag="Single" />
                        </ComboBox>
                        <TextBox
                            x:Name="FileNameBox"
                            Grid.Column="1"
                            Header="文件名"
                            Text="featured-plugins.json" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="ParseButton"
                            Click="OnParseClicked"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="解析并保存" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            Click="OnCancelClicked"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Cancel" />
                                <TextBlock Text="取消" />
                            </StackPanel>
                        </Button>
                        <ProgressRing
                            x:Name="BusyRing"
                            Width="24"
                            Height="24"
                            IsActive="False" />
                    </StackPanel>

                    <TextBlock
                        x:Name="StatusText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="等待输入"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Grid
                Grid.Column="1"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontWeight="SemiBold"
                        Text="JSON 预览" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="CopyButton"
                            Click="OnCopyClicked"
                            IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Copy" />
                                <TextBlock Text="复制" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OpenFolderButton"
                            Click="OnOpenFolderClicked"
                            IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="打开位置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="ResultBar"
                    Grid.Row="1"
                    IsClosable="False"
                    IsOpen="False" />

                <Border
                    Grid.Row="2"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBox
                        x:Name="PreviewBox"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        IsReadOnly="True"
                        PlaceholderText="解析结果将在这里显示"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
