                            x:Name="PluginViewTabs"
                            CanDragTabs="False"
                            CanReorderTabs="False"
                            IsAddTabButtonVisible="False"
                            SelectedIndex="0"
                            TabWidthMode="SizeToContent">
                            <TabViewItem
                                x:Name="FeaturedPluginsTab"
                                IsClosable="False">
                                <TabViewItem.Header>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="官方推荐" />
                                        <Border
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                            CornerRadius="5"
                                            Padding="6,1">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Text="精选" />
                                        </Border>
                                    </StackPanel>
                                </TabViewItem.Header>
                                <!-- 官方推荐：每页六个（两行三列），列表由后台管理端维护 -->
                                <StackPanel
                                    x:Name="FeaturedPluginsView"
                                    Margin="0,14,0,0"
                                    Spacing="12">
                                    <AutoSuggestBox
                                        x:Name="FeaturedPluginSearchBox"
                                        PlaceholderText="搜索推荐的插件"
                                        QueryIcon="Find" />
