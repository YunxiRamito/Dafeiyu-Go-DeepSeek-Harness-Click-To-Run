                                        <CheckBox x:Name="Spend10CheckBox" Content="¥10" MinWidth="0" IsChecked="True" />
                                        <CheckBox x:Name="Spend20CheckBox" Content="¥20" MinWidth="0" IsChecked="True" />
                                        <CheckBox x:Name="Spend50CheckBox" Content="¥50" MinWidth="0" IsChecked="True" />
                                    </StackPanel>
                                    <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="112" />
