<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeepSeekHarnessLauncher.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DeepSeekHarnessLauncher"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="Dafeiyu-Go 设置">

    <Grid
        x:Name="SettingsRoot"
        MinWidth="800"
        MinHeight="560"
        Background="Transparent">
        <Grid.Resources>
            <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
            <Thickness x:Key="NavigationViewItemButtonMargin">4,1,4,1</Thickness>
            <Style TargetType="PivotHeaderItem">
                <Setter Property="FontSize" Value="28" />
            </Style>
            <Style TargetType="PivotItem">
                <Setter Property="Margin" Value="0,20,0,0" />
            </Style>

            <Style x:Key="SettingsPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsPageDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="SettingsRowGridStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="ColumnSpacing" Value="24" />
            </Style>

            <Style x:Key="SettingsRowTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsRowDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsAccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsCompactButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsIconButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsTagPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsStatusPillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <!-- 跟着窗框风格走：Win11 圆角 4，Win10 直角（见 CornerRadiusHelper） -->
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="SettingsNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Width" Value="104" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsPathBoxStyle" TargetType="TextBox">
                <Setter Property="MinWidth" Value="300" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 插件卡片：本地 / 在线 / 官方推荐共用。标题过长可横向滚动，
                 简介固定两行并省略，按钮行贴在卡片底部，同一行卡片高度齐平。 -->
            <DataTemplate x:Key="PluginCardTemplate" x:DataType="local:PluginCardItem">
                <Border
                    MinHeight="196"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 圆形图标：有图标显示图标，没有则露出 GitHub 默认标记 -->
                                <Grid
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <Image
                                        Width="15"
                                        Height="15"
                                        Source="ms-appx:///assets/plugin-placeholder.svg" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush
                                                ImageSource="{x:Bind IconSource}"
                                                Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <ScrollViewer
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                </ScrollViewer>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind StarsVisibility}">
                                    <FontIcon FontSize="12" Glyph="&#xE735;" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Stars}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Height="34"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <Border
                                    Background="{x:Bind StatusBackground, Mode=OneWay}"
                                    Style="{StaticResource SettingsStatusPillStyle}"
                                    Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind StatusForeground, Mode=OneWay}"
                                        Text="{x:Bind Status, Mode=OneWay}" />
                                </Border>
                                <Border Style="{StaticResource SettingsTagPillStyle}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag1, Mode=OneWay}"
                                        Visibility="{x:Bind Tag1Visibility, Mode=OneWay}" />
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsTagPillStyle}"
                                    Visibility="{x:Bind Tag2Visibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag2, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Meta}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0">
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind LocalActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Tag="{x:Bind}"
                                    Style="{StaticResource SettingsIconButtonStyle}"
                                    Click="OpenPluginFolder_Click"
                                    ToolTipService.ToolTip="打开插件目录">
                                    <SymbolIcon Symbol="Folder" />
                                </Button>
                                <Button
                                    Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind CheckEnabled, Mode=OneWay}"
                                    MinWidth="0"
                                    Click="CheckPluginUpdate_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}"
                                    ToolTipService.ToolTip="手动链接的插件不参与更新检查" />
                                <Button
                                    Content="卸载"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="UninstallPlugin_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                            </Grid>
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind OnlineActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Content="查看详情"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="ShowPluginDetail_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                                <Grid
                                    Grid.Column="1"
                                    RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="0"
                                        Tag="{x:Bind}"
                                        Click="InstallOnlinePlugin_Click"
                                        IsEnabled="{x:Bind PrimaryEnabled, Mode=OneWay}"
                                        Style="{StaticResource SettingsAccentActionButtonStyle}"
                                        Height="32" />
                                        <ProgressBar
                                            Grid.Row="1"
                                            Height="3"
                                            HorizontalAlignment="Stretch"
                                            Maximum="100"
                                            CornerRadius="1"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}"
                                            Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 技能卡片：本地技能 / 在线技能市场共用。技能没有插件那种依赖状态，
                 卡片上只留「打开目录 / 启停 / 删除」或「详情 / 安装」两组按钮。 -->
            <DataTemplate x:Key="SkillCardTemplate" x:DataType="local:SkillCardItem">
                <Border
                    MinHeight="196"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center">
                                    <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <Image
                                        Width="15"
                                        Height="15"
                                        Source="ms-appx:///assets/plugin-placeholder.svg" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush
                                                ImageSource="{x:Bind IconSource}"
                                                Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <ScrollViewer
                                    Grid.Column="1"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                </ScrollViewer>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind StarsVisibility}">
                                    <FontIcon FontSize="12" Glyph="&#xE735;" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Stars}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Height="34"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <Border
                                    Background="{x:Bind StatusBackground, Mode=OneWay}"
                                    Style="{StaticResource SettingsStatusPillStyle}"
                                    Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{x:Bind StatusForeground, Mode=OneWay}"
                                        Text="{x:Bind Status, Mode=OneWay}" />
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsTagPillStyle}"
                                    Visibility="{x:Bind Tag1Visibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag1, Mode=OneWay}" />
                                </Border>
                                <Border
                                    Style="{StaticResource SettingsTagPillStyle}"
                                    Visibility="{x:Bind Tag2Visibility, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Tag2, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Meta}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0">
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind LocalActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Tag="{x:Bind}"
                                    Style="{StaticResource SettingsIconButtonStyle}"
                                    Click="OpenSkillFolder_Click"
                                    ToolTipService.ToolTip="打开技能目录">
                                    <SymbolIcon Symbol="Folder" />
                                </Button>
                                <Button
                                    Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind PrimaryEnabled, Mode=OneWay}"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="CheckSkillUpdate_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}"
                                    ToolTipService.ToolTip="和在线目录对比最近提交时间" />
                                <Button
                                    Content="启停"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="ToggleSkill_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}"
                                    ToolTipService.ToolTip="停用会把 SKILL.md 改名成 SKILL.md.disabled" />
                                <Button
                                    Content="删除"
                                    Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="DeleteSkill_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                            </Grid>
                            <Grid
                                ColumnSpacing="6"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind OnlineActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Content="查看详情"
                                    HorizontalAlignment="Stretch"
                                    MinWidth="0"
                                    Tag="{x:Bind}"
                                    Click="ShowSkillDetail_Click"
                                    Style="{StaticResource SettingsCompactButtonStyle}" />
                                <Grid
                                    Grid.Column="1"
                                    RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="0"
                                        Tag="{x:Bind}"
                                        Click="InstallSkill_Click"
                                        IsEnabled="{x:Bind PrimaryEnabled, Mode=OneWay}"
                                        Style="{StaticResource SettingsAccentActionButtonStyle}"
                                        Height="32" />
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="3"
                                        HorizontalAlignment="Stretch"
                                        Maximum="100"
                                        CornerRadius="1"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}"
                                        Visibility="{x:Bind BusyVisibility, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 开发者管理：推荐条目的一行。左侧序号与信息，右侧排序与增删。 -->
            <DataTemplate x:Key="DeveloperEntryTemplate" x:DataType="local:DeveloperEntryCard">
                <Border
                    Margin="0,0,0,8"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MinWidth="22"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Order}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Click="DeveloperMoveUp_Click"
                            Style="{StaticResource SettingsIconButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="上移">
                            <FontIcon FontSize="12" Glyph="&#xE74A;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Click="DeveloperMoveDown_Click"
                            Style="{StaticResource SettingsIconButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="下移">
                            <FontIcon FontSize="12" Glyph="&#xE74B;" />
                        </Button>
                        <Button
                            Grid.Column="4"
                            Click="DeveloperEdit_Click"
                            Style="{StaticResource SettingsCompactButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="改名称、说明与备注">
                            编辑
                        </Button>
                        <Button
                            Grid.Column="5"
                            Click="DeveloperRemove_Click"
                            Style="{StaticResource SettingsCompactButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="从推荐列表移除">
                            移除
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 主页公告条：标签 + 日期 + 标题 + 一行正文 -->
            <DataTemplate x:Key="HomeAnnouncementTemplate" x:DataType="local:AnnouncementItem">
                <Border
                    Margin="0,0,0,8"
                    Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource SettingsTagPillStyle}">
                                <TextBlock
                                    FontSize="11"
                                    Text="{x:Bind TagOrFallback}" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Date}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{x:Bind Title}"
                            TextWrapping="Wrap" />
                        <ContentControl Tag="{x:Bind Body}" Loaded="HomeAnnouncementMarkdown_Loaded" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </DataTemplate>

        <!-- 搜索候选：标题 + 描述，右侧小字是它所在的一级入口 · 页面 -->
        <DataTemplate x:Key="SettingsSearchSuggestionTemplate" x:DataType="local:SettingsSearchSuggestion">
            <Grid Padding="4,5" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="13"
                        Text="{x:Bind Entry.Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Entry.Description}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Entry.DisplayPath}" />
            </Grid>
        </DataTemplate>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <Image
                    Width="20"
                    Height="20"
                    Source="ms-appx:///assets/DeepSeek-icon.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Dafeiyu-Go 设置" />
            </StackPanel>

            <!-- 搜索放标题栏正中，椭圆输入框；命中提示跟在右边，不占导航栏 -->
            <StackPanel
                x:Name="SettingsSearchHost"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    x:Name="SettingsSearchShell"
                    Width="360"
                    Height="34"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="17">
                    <AutoSuggestBox
                        x:Name="SettingsSearchBox"
                        Margin="6,0"
                        Padding="4,0"
                        AutomationProperties.Name="搜索设置"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        PlaceholderText="搜索设置"
                        QueryIcon="Find"
                                                                         
                                                                             
                                                                   
                        UseSystemFocusVisuals="False"
                        VerticalContentAlignment="Center" QuerySubmitted="SettingsSearchBox_QuerySubmitted" SuggestionChosen="SettingsSearchBox_SuggestionChosen" TextChanged="SettingsSearchBox_TextChanged">
                        <!--
                            聚焦不再画系统方框，也不让内层 TextBox 冒出聚焦下划线和悬浮底色：
                            提示改由外层胶囊边框染色（见 SetSearchShellFocused）。
                        -->
                        <AutoSuggestBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        </AutoSuggestBox.Resources>
                    </AutoSuggestBox>
                </Border>
            </StackPanel>

            <!-- 让开系统的最小化 / 最大化 / 关闭 -->
            <Border
                Grid.Column="2"
                Width="140" />
        </Grid>

        <Border
            Grid.Row="0"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.28" />

        <NavigationView
            x:Name="SettingsNavigationView"
            Grid.Row="1"
            CompactPaneLength="52"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="False"
            OpenPaneLength="224"
            PaneDisplayMode="Left"
                                                                       SelectionChanged="SettingsNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <!-- Windows 11 replaces these placeholders with original Microsoft color SVGs after InitializeComponent;
                     Windows 10 keeps the native SymbolThemeFontFamily glyphs. -->
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="主页"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="ModelsNavItem"
                    Content="模型"
                    Tag="Model">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                    一级入口：主页 / 通用（常规·提醒·外观·API 与翻译） /
                    拓展（插件·技能） / 核心（服务·组件） / 更新 / 关于。
                    更新单独一层；下载任务与开发者留在 Footer，开发者是隐藏入口。
                    组内使用页内 Pivot 导航，页面不再重复写自己的大标题。
                -->
                <NavigationViewItem
                    x:Name="BasicNavItem"
                    Content="通用"
                    Tag="Basic">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="FeaturesNavItem"
                    Content="拓展"
                    Tag="Features">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9CE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SystemNavItem"
                    Content="核心"
                    Tag="System">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="UpdatesNavItem"
                    Content="更新"
                    Tag="UpdatesGroup">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 补丁提供的动态页面挂在这里；没有补丁页面时整个入口藏着。 -->
                <NavigationViewItem
                    x:Name="PatchesNavItem"
                    Content="补丁"
                    Tag="Patches"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AboutNavItem"
                    Content="关于"
                    Tag="AboutGroup">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="DownloadsNavItem"
                    Content="下载任务"
                    Tag="Downloads"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DeveloperNavItem"
                    Content="开发者"
                    Tag="Developer"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ServerMetricsFooterEntry" Tag="ServerMetrics" SelectsOnInvoked="True" IsTabStop="False" Margin="0,2,0,8" ToolTipService.ToolTip="服务器监控">
                    <NavigationViewItem.Content>
                        <Button x:Name="ServerMetricsFooterButton" Click="NoticePresenceFooterItem_Tapped" HorizontalAlignment="Stretch" Padding="8,4" Background="Transparent" BorderThickness="0">
                        <StackPanel x:Name="NoticePresenceFooterButtonPanel" Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <Ellipse x:Name="NoticePresenceDot" Width="8" Height="8" Fill="#8A8A8A" VerticalAlignment="Center" />
                            <TextBlock x:Name="NoticePresenceText" Text="在线状态未连接" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        </Button>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
            <ScrollViewer
                x:Name="SettingsScroller"
                Padding="20,18,20,38"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="SettingsContentHost"
                    Width="760"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    Spacing="16">

                    <!-- 主页：一句版本 + 三格状态 + 公告 + 快捷入口 -->
                    <StackPanel
                        x:Name="HomePage"
                        Spacing="16">
                        <TextBlock
                            Style="{StaticResource SettingsPageTitleTextStyle}"
                            Text="主页" />

                        <!-- 账户摘要与用量趋势。金额口径在指标旁明确标注。 -->
                        <Border x:Name="HomeUsagePanel" Style="{StaticResource SettingsCardStyle}" Padding="20,18">
                            <StackPanel Spacing="18">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="HomeUsageTitleText"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Token 用量与余额" />
                                    <ComboBox
                                        x:Name="HomeUsageRangeBox"
                                        Grid.Column="1"
                                        MinWidth="112"
                                                                                             
                                        Style="{StaticResource SettingsComboBoxStyle}" SelectionChanged="HomeUsageRangeBox_SelectionChanged">
                                        <ComboBoxItem
                                            Content="近 7 天"
                                            Tag="7" />
                                        <ComboBoxItem
                                            Content="近 15 天"
                                            Tag="15" />
                                        <ComboBoxItem
                                            Content="近 30 天"
                                            Tag="30" />
                                    </ComboBox>
                                    <Button
                                        x:Name="HomeUsageRefreshButton"
                                        Grid.Column="2"
                                        Content="刷新"
                                                                            
                                        Style="{StaticResource SettingsCompactButtonStyle}"  Click="HomeUsageRefreshButton_Click"/>
                                </Grid>
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="账户余额" Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                        <TextBlock x:Name="HomeUsageBalanceText" Text="—" FontSize="28" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="HomeUsageBalanceStateText" Text="正在读取…"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Margin="0,4"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="今日 Token" Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                        <TextBlock x:Name="HomeUsageTodayTokensText" Text="—" FontSize="24" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HomeUsageTodayRequestsText" Text="等待统计"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="6">
                                        <TextBlock Text="今日花费 · 估算" Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                        <TextBlock x:Name="HomeUsageTodayCostText" Text="—" FontSize="24" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HomeUsageTodayLedgerText" Text="按模型单价计算"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="HomeUsageChartPanel"
                                        Padding="14,12" CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="用量趋势" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="8" Height="10" VerticalAlignment="Center"
                                                            Background="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                    <TextBlock Text="Token" Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="14" Height="2" VerticalAlignment="Center"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="估算花费" Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Canvas x:Name="HomeUsageChart" Height="172" Background="Transparent"
                                                                                            
                                                                                          
                                                                                          PointerExited="HomeUsageChart_PointerExited" PointerMoved="HomeUsageChart_PointerMoved" SizeChanged="HomeUsageChart_SizeChanged"/>
                                        <TextBlock x:Name="HomeUsageChartPeakText"
                                                   Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    x:Name="HomeUsageHintText"
                                    Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="HomeUsageInstallButton"
                                    Content="安装用量统计插件"
                                                                        
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Visibility="Collapsed"  Click="HomeUsageInstallButton_Click"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="HomeStatusSection" Spacing="16" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="公告" />
                                    <Border
                                        x:Name="HomeUnreadPill"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                        Style="{StaticResource SettingsStatusPillStyle}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="HomeUnreadText"
                                            FontSize="12"
                                            Text="有新公告" />
                                    </Border>
                                    <Button
                                        x:Name="HomeAnnouncementRefreshButton"
                                        Grid.Column="2"
                                        Content="刷新"
                                        Style="{StaticResource SettingsCompactButtonStyle}" />
                                    <Button
                                        x:Name="HomeAnnouncementReadButton"
                                        Grid.Column="3"
                                        Content="全部已读"
                                        Style="{StaticResource SettingsCompactButtonStyle}" />
                                </Grid>
                                <ItemsRepeater
                                    x:Name="HomeAnnouncementRepeater"
                                    ItemTemplate="{StaticResource HomeAnnouncementTemplate}" />
                                <TextBlock
                                    x:Name="HomeAnnouncementEmptyText"
                                    Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                    Text="还没有公告。"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="HomeAnnouncementStateText"
                                    Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                            </StackPanel>
                        </Border>


                        <Border x:Name="HomeNotificationPanel" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="当前通知" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="HomeNotificationRefreshButton" Grid.Column="1" Content="刷新" Click="HomeNotificationRefresh_Click" Style="{StaticResource SettingsCompactButtonStyle}" />
                                </Grid>
                                <TextBlock x:Name="HomeNotificationStateText" Text="正在读取…" Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                <StackPanel x:Name="HomeNotificationContentPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock x:Name="HomeNotificationTitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HomeNotificationDateText" Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                    <ContentControl x:Name="HomeNotificationMarkdownHost" HorizontalContentAlignment="Stretch" />
                                    <StackPanel x:Name="HomeNotificationButtonsHost" Spacing="8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="HomeBrandPanel" Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="Dafeiyu-Go" />
                                    <TextBlock
                                        x:Name="HomeVersionText"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="启动器 - · DSH -" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="HomeCheckUpdateButton"
                                        Content="检查更新"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        x:Name="HomeRestartButton"
                                        Content="重启 DSH"
                                        Style="{StaticResource SettingsAccentActionButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="HomeStatusGrid" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="DSH 服务" />
                                    <TextBlock
                                        x:Name="HomeServiceText"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="-" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="启动器" />
                                    <TextBlock
                                        x:Name="HomeLauncherText"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="-" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="DSH 本体" />
                                    <TextBlock
                                        x:Name="HomeDshText"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="-" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>

                    <StackPanel
                        x:Name="ModelPage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsPageTitleTextStyle}" Text="模型" />
                        <TextBlock Style="{StaticResource SettingsPageDescriptionTextStyle}"
                                   Text="管理由此启动器启动的 DSH 的模型提供商与模型目录。这里的设置只影响通过此启动器启动的 DSH。" TextWrapping="Wrap" />
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="模型提供商" />
                                        <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                                   Text="排列提供商顺序，管理其模型目录；自定义提供商可编辑、检测连通或删除。" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="ModelRefreshButton" Grid.Column="1" Content="刷新目录"
                                            Style="{StaticResource SettingsCompactButtonStyle}" Click="ModelRefreshButton_Click" />
                                    <Button x:Name="ModelAddProviderButton" Grid.Column="2" Content="添加提供商"
                                            Style="{StaticResource SettingsAccentActionButtonStyle}" Click="ModelAddProviderButton_Click" />
                                </Grid>
                                <InfoBar x:Name="ModelStatusInfoBar" IsOpen="False" IsClosable="False" />
                                <StackPanel x:Name="ModelProvidersPanel" Spacing="8" />
                                <TextBlock x:Name="ModelProvidersEmptyText" Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                           Text="暂无自定义供应商。" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="API 密钥与余额" />
                                <TextBlock x:Name="ModelBalanceText" FontSize="20" FontWeight="SemiBold" Text="余额：—" />
                                <TextBlock Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                           Text="已保存的 API 密钥由 DSH 保管，启动器只能查看是否已配置，无法读取或回显明文。余额查询只适用于明确支持的服务；目前此处显示启动器已接入的 DeepSeek 余额，其他供应商没有统一余额接口。" TextWrapping="Wrap" />
                                <Button x:Name="ModelBalanceRefreshButton" Content="刷新 DeepSeek 余额"
                                        Style="{StaticResource SettingsCompactButtonStyle}" Click="ModelBalanceRefreshButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ServerMetricsPage" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsPageTitleTextStyle}" Text="服务器" />
                        <TextBlock x:Name="ServerMetricsStatusText" Style="{StaticResource SettingsPageDescriptionTextStyle}" Text="正在读取服务器状态…" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="CPU" />
                                    <ProgressBar x:Name="ServerCpuBar" Maximum="100" />
                                    <TextBlock x:Name="ServerCpuText" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="内存" />
                                    <ProgressBar x:Name="ServerMemoryBar" Maximum="100" />
                                    <TextBlock x:Name="ServerMemoryText" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="网络" />
                                    <ProgressBar x:Name="ServerNetworkBar" Maximum="100" />
                                    <TextBlock x:Name="ServerNetworkText" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="硬盘" />
                                    <ProgressBar x:Name="ServerDiskBar" Maximum="100" />
                                    <TextBlock x:Name="ServerDiskText" Text="--" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid x:Name="ServerChartsGrid" ColumnSpacing="24" RowSpacing="20" SizeChanged="ServerChartsGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="ServerPresenceChartCard" Grid.Column="0" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="在线人数 · 近 24 小时" />
                                    <TextBlock x:Name="ServerPresenceSummaryText" Text="正在读取在线人数历史…" TextWrapping="Wrap" />
                                    <Canvas x:Name="ServerPresenceChart" Height="270" Background="Transparent" HorizontalAlignment="Stretch" SizeChanged="ServerPresenceChart_SizeChanged" PointerMoved="ServerPresenceChart_PointerMoved" PointerExited="ServerPresenceChart_PointerExited" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ServerVersionChartCard" Grid.Column="1" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="在线版本分布" />
                                    <TextBlock x:Name="ServerVersionSummaryText" Text="正在读取启动器版本…" TextWrapping="Wrap" />
                                    <Canvas x:Name="ServerVersionChart" Height="270" Background="Transparent" HorizontalAlignment="Stretch" SizeChanged="ServerVersionChart_SizeChanged" PointerMoved="ServerVersionChart_PointerMoved" PointerExited="ServerVersionChart_PointerExited" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ServerUploadChartCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="网络上传带宽" />
                                    <TextBlock x:Name="ServerUploadSummaryText" Text="上传带宽上限 30 Mbps · 近 5 分钟" TextWrapping="Wrap" />
                                    <Canvas x:Name="ServerUploadChart" Height="240" Background="Transparent" HorizontalAlignment="Stretch" SizeChanged="ServerUploadChart_SizeChanged" PointerMoved="ServerUploadChart_PointerMoved" PointerExited="ServerUploadChart_PointerExited" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="硬件信息" />
                                <TextBlock x:Name="ServerHardwareText" Style="{StaticResource SettingsPageDescriptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--
                        分组内容宿主：一级入口选择分组，页内 Pivot 选择页面。
                        保留原有页面实例、字段和事件绑定。
                    -->
                    <StackPanel
                        x:Name="BasicPage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <Pivot x:Name="BasicTabs"                                                     HorizontalAlignment="Stretch"  SelectionChanged="SettingsSection_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel
                        x:Name="FeaturesPage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <Pivot x:Name="FeaturesTabs"                                                     HorizontalAlignment="Stretch"  SelectionChanged="SettingsSection_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel
                        x:Name="SystemPage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <Pivot x:Name="SystemTabs"                                                     HorizontalAlignment="Stretch"  SelectionChanged="SettingsSection_SelectionChanged"/>
                    </StackPanel>

                    <!-- 更新分组：常规更新与补丁管理共用一级入口。 -->
                    <StackPanel x:Name="UpdatesGroupPage" Spacing="16" Visibility="Collapsed">
                        <Pivot x:Name="UpdatesTabs" HorizontalAlignment="Stretch" SelectionChanged="SettingsSection_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="AboutGroupPage" Spacing="16" Visibility="Collapsed">
                        <Pivot x:Name="AboutTabs" HorizontalAlignment="Stretch" SelectionChanged="SettingsSection_SelectionChanged"/>
                    </StackPanel>

                    <!-- 补丁提供的动态页面位于补丁管理子页末尾。 -->
                    <StackPanel
                        x:Name="PatchesPage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="PatchesEmptyText"
                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                            Text="还没有补丁提供页面。"
                            Visibility="Collapsed" />
                        <Pivot x:Name="PatchesTabs" HorizontalAlignment="Stretch" SelectionChanged="SettingsSection_SelectionChanged"/>
                    </StackPanel>

                    <!-- 常规 -->
                    <StackPanel
                        x:Name="GeneralPage"
                        Spacing="16">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="启动端口" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="DSH 服务的监听端口。" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="14">
                                        <RadioButton
                                            x:Name="RandomPortRadio"
                                            Content="随机端口"
                                            GroupName="StartupPortMode"
                                            Tag="Random"
                                                                             Checked="PortModeRadio_Checked"/>
                                        <RadioButton
                                            x:Name="FixedPortRadio"
                                            Content="固定端口"
                                            GroupName="StartupPortMode"
                                            Tag="Fixed"
                                                                             Checked="PortModeRadio_Checked"/>
                                        <RadioButton
                                            x:Name="DefaultPortRadio"
                                            Content="默认 3080"
                                            GroupName="StartupPortMode"
                                            Tag="Default"
                                            IsChecked="True"
                                            Checked="PortModeRadio_Checked" />
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    x:Name="FixedPortRow"
                                    ColumnSpacing="16"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="固定端口" />
                                    <NumberBox
                                        x:Name="FixedPortBox"
                                        Grid.Column="1"
                                        Minimum="1024"
                                        Maximum="65535"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        MinWidth="104" Width="104" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Value="8787" />
                                </Grid>

                                <InfoBar
                                    x:Name="DefaultPortWarning"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Message="使用默认端口可能导致您的 DSH 服务遭受外部攻击。请确认您未使用公网 IP，并确定局域网内无威胁设备。"
                                    Severity="Warning"
                                    Title="安全提示" />
                                <InfoBar
                                    x:Name="PortChangeInfoBar"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Message="操作将会在下次启动服务时生效。"
                                    Severity="Success"
                                    Title="已保存" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="开机自启动" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="登录 Windows 时启动。" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="StartWithWindowsToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    IsOn="True" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="静默启动" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="选择启动时是否打开网页。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="SilentStartComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBoxItem Content="全部" Tag="All" />
                                    <ComboBoxItem Content="仅开机自启" Tag="StartupOnly" />
                                    <ComboBoxItem Content="关闭" Tag="Off" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid Style="{StaticResource SettingsRowGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="在线引擎" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="更新与在线插件的网络入口。" />
                                    </StackPanel>
                                    <Button
                                        x:Name="AcceleratorAdvancedToggle"
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource SettingsCompactButtonStyle}"
                                        ToolTipService.ToolTip="选加速源、看各源延迟">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                x:Name="AcceleratorAdvancedChevron"
                                                FontSize="10"
                                                Glyph="&#xE70D;" />
                                            <TextBlock Text="高级设置" />
                                        </StackPanel>
                                    </Button>
                                    <ComboBox
                                        x:Name="UpdateSourceComboBox"
                                        Grid.Column="2"
                                        MinWidth="180"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <ComboBoxItem
                                            x:Name="UpdateSourceAcceleratedItem"
                                            Content="大陆 CDN 加速"
                                            Tag="Accelerated" />
                                        <ComboBoxItem Content="后端服务器加速" Tag="backend" />
                                        <ComboBoxItem
                                            x:Name="UpdateSourceCustomItem"
                                            Content="自定义"
                                            Tag="Custom"
                                            Visibility="Collapsed" />
                                        <ComboBoxItem Content="官方源" Tag="Official" />
                                    </ComboBox>
                                </Grid>

                                <StackPanel
                                    x:Name="AcceleratorAdvancedPanel"
                                    Spacing="10"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="AcceleratorAdvancedHint"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="自动测速并选择最快源。" />
                                    <RadioButtons
                                        x:Name="AcceleratorSourceSelector"
                                                                                                      SelectionChanged="AcceleratorSourceSelector_SelectionChanged">
                                        <RadioButton
                                            x:Name="AcceleratorAutoRadio"
                                            Content="自动（推荐）"
                                            Tag="Auto" />
                                        <RadioButton x:Name="AcceleratorGhproxyRadio" Tag="ghproxy" Content="ghproxy.net" />
                                        <RadioButton x:Name="AcceleratorGhProxyRadio" Tag="gh-proxy" Content="gh-proxy.com" />
                                        <RadioButton x:Name="AcceleratorGhfastRadio" Tag="ghfast" Content="ghfast.top" />
                                        <RadioButton x:Name="AcceleratorJsdelivrRadio" Tag="jsdelivr" Content="jsDelivr" />
                                    </RadioButtons>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="AcceleratorLatencyText"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="还没测速。" />
                                        <Button
                                            x:Name="AcceleratorLatencyButton"
                                            Grid.Column="1"
                                            Content="重新测速"
                                            Style="{StaticResource SettingsCompactButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="插件来源" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="插件目录与安装包的来源。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="PluginSourceComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    MinWidth="200" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="代理设置" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="先选代理模式，再决定它对谁生效。默认启动器走代理，DSH 服务不接管。" />
                                </StackPanel>
                                <!-- 故意不写 SelectedIndex：写死的 0 会在首次布局时把选中项
                                     拽回「不使用代理」，紧接着 SelectionChanged 就把刚读出来的
                                     代理设置覆盖成直连。选中项统一由代码按配置设置。 -->
                                <RadioButtons x:Name="ProxyModeSelector">
                                    <RadioButton
                                        Content="不使用代理"
                                        Tag="None" />
                                    <RadioButton
                                        Content="使用系统代理"
                                        Tag="System" />
                                    <RadioButton
                                        Content="使用自定义代理"
                                        Tag="Custom" />
                                </RadioButtons>
                                <ContentControl
                                    x:Name="ProxyCustomPanel"
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="False">
                                    <StackPanel Spacing="12">
                                    <RadioButtons
                                        x:Name="ProxyProtocolSelector"
                                        Header="代理协议"
                                        MaxColumns="3">
                                        <RadioButton
                                            Content="http 代理（推荐）"
                                            Tag="Http" />
                                        <RadioButton
                                            Content="https 代理（代理端 TLS）"
                                            Tag="Https" />
                                        <RadioButton
                                            Content="socks5"
                                            Tag="Socks5" />
                                    </RadioButtons>
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="本地代理选 http；https 走 TLS。SOCKS5 仅支持启动器，不能用于 DSH 服务。" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ProxyHostBox"
                                            Header="代理地址"
                                            PlaceholderText="127.0.0.1"
                                            Text="127.0.0.1" />
                                        <NumberBox
                                            x:Name="ProxyPortBox"
                                            Grid.Column="1"
                                            Header="端口"
                                            Maximum="65535"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="7890"
                                            Width="128" />
                                    </Grid>
                                    </StackPanel>
                                </ContentControl>

                                <!-- 生效范围：两个开关互不影响。 -->
                                <StackPanel Spacing="2">
                                    <ToggleSwitch
                                        x:Name="ProxyForLauncherToggle"
                                        Header="对启动器生效"
                                        OffContent="关闭"
                                        OnContent="开启" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="更新检查、插件目录、下载，以及启动器拉起的 pnpm / npm / git。" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <ToggleSwitch
                                        x:Name="ProxyForDshToggle"
                                        Header="对 DSH 服务生效"
                                        OffContent="关闭"
                                        OnContent="开启" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="接管 DSH 的 HTTP/HTTPS 代理；不使用代理模式强制直连。关闭时保留 DSH 原环境。改动后需要重启服务。" />
                                    <TextBlock x:Name="ProxyDshErrorText"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BuildSettingsGroups moves this section into the backup/import tab. -->
                        <Border x:Name="DymBackupSection" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="DYM 文件" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="导入或导出 Dafeiyu-Go 的 .dym 备份文件，包含配置、技能和插件。" />
                                    </StackPanel>
                                    <Button
                                        x:Name="BackupExportButton"
                                        Grid.Column="1"
                                                                        
                                        Content="导出 DYM"
                                        Style="{StaticResource SettingsActionButtonStyle}"  Click="BackupExportButton_Click"/>
                                    <Button
                                        x:Name="BackupImportButton"
                                        Grid.Column="2"
                                                                        
                                        Content="导入 DYM"
                                        Style="{StaticResource SettingsActionButtonStyle}"  Click="BackupImportButton_Click"/>
                                </Grid>

                                <InfoBar
                                    x:Name="BackupInfoBar"
                                    IsClosable="True"
                                    IsOpen="False" />

                                <!-- 导出 -->
                                <StackPanel
                                    x:Name="BackupExportPanel"
                                    Spacing="10"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource SettingsRowTitleTextStyle}"
                                            Text="导出内容" />
                                        <StackPanel
                                            x:Name="BackupExportGroupsHost"
                                            Spacing="2" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="BackupExportTargetBox"
                                            IsReadOnly="True"
                                            Style="{StaticResource SettingsPathBoxStyle}" />
                                        <Button
                                            x:Name="BackupExportFolderButton"
                                            Visibility="Collapsed"
                                            Grid.Column="1"
                                                                                  
                                            Content="选择文件夹"
                                            Style="{StaticResource SettingsActionButtonStyle}"  Click="BackupExportFolderButton_Click"/>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BackupExportStartButton"
                                            Visibility="Collapsed"
                                                                                 
                                            Content="开始导出"
                                            Style="{StaticResource SettingsAccentActionButtonStyle}"  Click="BackupExportStartButton_Click"/>
                                        <ProgressBar
                                            x:Name="BackupExportProgress"
                                            Grid.Column="1"
                                            Maximum="100"
                                            Minimum="0"
                                            VerticalAlignment="Center"
                                            Value="0" />
                                        <Button
                                            x:Name="BackupExportCancelButton"
                                            Grid.Column="2"
                                                                      
                                            Content="取消"
                                            Style="{StaticResource SettingsCompactButtonStyle}"
                                            Visibility="Collapsed"  Click="BackupCancel_Click"/>
                                    </Grid>
                                    <TextBlock
                                        x:Name="BackupExportDetail"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                </StackPanel>

                                <!-- 导入 -->
                                <StackPanel
                                    x:Name="BackupImportPanel"
                                    Spacing="10"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="BackupImportFileBox"
                                            IsReadOnly="True"
                                            PlaceholderText="还没选备份包"
                                            Style="{StaticResource SettingsPathBoxStyle}" />
                                        <Button
                                            x:Name="BackupImportPickButton"
                                            Visibility="Collapsed"
                                            Grid.Column="1"
                                                                                
                                            Content="选择备份包"
                                            Style="{StaticResource SettingsActionButtonStyle}"  Click="BackupImportPickButton_Click"/>
                                    </Grid>
                                    <StackPanel
                                        x:Name="BackupImportGroupsPanel"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource SettingsRowTitleTextStyle}"
                                                Text="导入内容" />
                                            <StackPanel
                                                x:Name="BackupImportGroupsHost"
                                                Spacing="2" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                                Text="碰到同名文件" />
                                            <ComboBox
                                                x:Name="BackupImportConflictBox"
                                                Grid.Column="1"
                                                Style="{StaticResource SettingsComboBoxStyle}" />
                                        </Grid>
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BackupImportStartButton"
                                            Visibility="Collapsed"
                                                                                 
                                            Content="开始导入"
                                            Style="{StaticResource SettingsAccentActionButtonStyle}"  Click="BackupImportStartButton_Click"/>
                                        <ProgressBar
                                            x:Name="BackupImportProgress"
                                            Grid.Column="1"
                                            Maximum="100"
                                            Minimum="0"
                                            VerticalAlignment="Center"
                                            Value="0" />
                                        <Button
                                            x:Name="BackupImportCancelButton"
                                            Grid.Column="2"
                                                                      
                                            Content="取消"
                                            Style="{StaticResource SettingsCompactButtonStyle}"
                                            Visibility="Collapsed"  Click="BackupCancel_Click"/>
                                    </Grid>
                                    <TextBlock
                                        x:Name="BackupImportDetail"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- 主题 -->
                    <StackPanel
                        x:Name="ThemePage"
                        Spacing="16"
                        Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="主题" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="窗口与托盘的主题。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="2"
                                                                                     
                                    MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="窗口风格" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="切换立即生效。" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="WindowStyleComboBox"
                                    Grid.Column="1"
                                    SelectedIndex="1"
                                                                                           
                                    MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="WindowStyleComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Windows 10" Tag="Windows10" />
                                    <ComboBoxItem Content="Windows 11" Tag="Windows11" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="主题色来源" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="跟随系统主题色，或自定义。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ComboBox
                                        x:Name="AccentSourceComboBox"
                                        MinWidth="168"
                                        SelectedIndex="0"
                                                                                                 SelectionChanged="AccentSourceComboBox_SelectionChanged">
                                        <ComboBoxItem Content="跟随 Windows" Tag="System" />
                                        <ComboBoxItem Content="自选" Tag="Custom" />
                                    </ComboBox>
                                    <Button
                                        x:Name="CustomAccentButton"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        Visibility="Collapsed">
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    x:Name="AccentColorPicker"
                                                                                                 
                                                    IsAlphaEnabled="False"
                                                    IsAlphaSliderVisible="False"
                                                    IsAlphaTextInputVisible="False"  ColorChanged="AccentColorPicker_ColorChanged"/>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border
                                            x:Name="AccentColorSwatch"
                                            Width="20"
                                            Height="20"
                                            Background="#0A84FF"
                                            CornerRadius="{ThemeResource ControlCornerRadius}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
