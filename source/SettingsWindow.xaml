                                        VerticalAlignment="Center"
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="更新日志" />
                                    <TextBlock
                                        x:Name="ChangelogVersionText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="当前版本" />
                                    <Button
                                        x:Name="ChangelogRefreshButton"
                                        Grid.Column="2"
                                        Content="刷新"
                                        Style="{StaticResource SettingsCompactButtonStyle}" />
                                </Grid>
                                <ScrollViewer
                                    x:Name="ChangelogScroller"
                                    MaxHeight="340"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        x:Name="ChangelogText"
                                        FontSize="13"
                                        LineHeight="20"
                                        Text="正在读取更新日志…"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="16">
                            <TextBlock
                                Margin="0,14,0,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="关于作者" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="16">
                                    <Border
                                        Width="72"
                                        Height="72"
                                        Background="#303030"
                                        CornerRadius="36">
                                        <Grid>
                                            <ProgressRing
                                                x:Name="AuthorAvatarLoading"
                                                Width="24"
                                                Height="24"
                                                Foreground="White"
                                                IsActive="True" />
                                            <Image
                                                x:Name="AuthorAvatarImage"
                                                Stretch="UniformToFill"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="雨沫云汐" />
                                        <TextBlock
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                            Text="Dafeiyu-Go 启动器作者" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="OpenBilibili_Click"
                                        Content="哔哩哔哩"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        Click="OpenDouyin_Click"
                                        Content="抖音"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SettingsRowTitleTextStyle}"
                                        Text="支持一下" />
                                    <TextBlock
                                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                        Text="请作者喝杯奶茶。" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="28">
                                    <StackPanel Spacing="8">
                                        <Border
                                            Width="180"
                                            Height="180"
                                            Background="White"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <Image
                                                Source="ms-appx:///assets/donate-alipay.jpg"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="支付宝" />
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <Border
                                            Width="180"
                                            Height="180"
                                            Background="White"
                                            CornerRadius="{ThemeResource ControlCornerRadius}">
                                            <Image
                                                Source="ms-appx:///assets/donate-wechat.png"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="微信" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>


                    </StackPanel>
                    <!-- 开发者管理：模块化。加新板块 = 左边 DeveloperModuleList 加一条 +
                         右边加一个同名面板，并在代码的模块表里登记（见 HANDOVER）。 -->
                    <StackPanel
                        x:Name="DeveloperPage"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource SettingsPageTitleTextStyle}"
                            Text="开发者" />

                        <InfoBar
                            x:Name="DeveloperInfoBar"
                            IsClosable="False"
                            IsOpen="False" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListView
                                x:Name="DeveloperModuleList"
                                SelectionChanged="DeveloperModule_SelectionChanged"
                                SelectionMode="Single">
                                <ListViewItem Content="推荐管理" Tag="Featured" />
                                <ListViewItem Content="下载源（未开放）" Tag="Sources" />
                                <ListViewItem Content="公告" Tag="Announce" />
                                <ListViewItem Content="权限（未开放）" Tag="Roles" />
                            </ListView>
                            <Grid Grid.Column="1">
                                <!-- 模块：推荐管理 -->
                                <StackPanel
                                    x:Name="DeveloperFeaturedPanel"
                                    Spacing="12">
                                    <TabView
                                        x:Name="DeveloperTabs"
                                        CanDragTabs="False"
                                        CanReorderTabs="False"
                                        IsAddTabButtonVisible="False"
                                        TabWidthMode="SizeToContent">
                                        <TabViewItem
                                            x:Name="DeveloperPluginTab"
                                            Header="插件推荐"
                                            IsClosable="False">
                                            <StackPanel Margin="0,14,0,0" Spacing="10">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <AutoSuggestBox
                                                        x:Name="DeveloperPluginInput"
                                                        PlaceholderText="粘贴 GitHub 仓库地址或 owner/repo"
                                                        QueryIcon="Link" />
                                                    <Button
                                                        x:Name="DeveloperPluginImportButton"
                                                        Grid.Column="1"
                                                        Content="导入"
                                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="DeveloperPluginCountText"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                                    <Button
                                                        x:Name="DeveloperPluginLoadButton"
                                                        Grid.Column="1"
                                                        Content="从仓库读取"
                                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                                    <Button
                                                        x:Name="DeveloperPluginPublishButton"
                                                        Grid.Column="2"
                                                        Content="发布到仓库"
                                                        Style="{StaticResource SettingsAccentActionButtonStyle}" />
                                                </Grid>
                                                <ItemsRepeater
                                                    x:Name="DeveloperPluginRepeater"
                                                    ItemTemplate="{StaticResource DeveloperEntryTemplate}" />
                                            </StackPanel>
                                        </TabViewItem>
                                        <TabViewItem
                                            x:Name="DeveloperSkillTab"
                                            Header="技能推荐"
                                            IsClosable="False">
                                            <StackPanel Margin="0,14,0,0" Spacing="10">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <AutoSuggestBox
                                                        x:Name="DeveloperSkillInput"
                                                        PlaceholderText="粘贴仓库地址，加 #子目录 可指定技能"
                                                        QueryIcon="Link" />
                                                    <Button
                                                        x:Name="DeveloperSkillImportButton"
                                                        Grid.Column="1"
                                                        Content="导入"
                                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="DeveloperSkillCountText"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                                    <Button
                                                        x:Name="DeveloperSkillLoadButton"
                                                        Grid.Column="1"
                                                        Content="从仓库读取"
                                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                                    <Button
                                                        x:Name="DeveloperSkillPublishButton"
                                                        Grid.Column="2"
                                                        Content="发布到仓库"
                                                        Style="{StaticResource SettingsAccentActionButtonStyle}" />
                                                </Grid>
                                                <ItemsRepeater
                                                    x:Name="DeveloperSkillRepeater"
                                                    ItemTemplate="{StaticResource DeveloperEntryTemplate}" />
                                            </StackPanel>
                                        </TabViewItem>
                                    </TabView>
                                </StackPanel>

                                <!-- 模块：下载源（预留） -->
                                <StackPanel
                                    x:Name="DeveloperSourcesPanel"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Style="{StaticResource SettingsRowTitleTextStyle}"
                                                Text="下载源与镜像" />
                                            <TextBlock
                                                Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                                Text="以后放下载源与镜像池开关。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 模块：公告 -->
                                <StackPanel
                                    x:Name="DeveloperAnnouncePanel"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="DeveloperAnnounceCountText"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingsRowDescriptionTextStyle}" />
                                        <Button
                                            x:Name="DeveloperAnnounceAddButton"
                                            Grid.Column="1"
                                            Content="新增"
                                            Style="{StaticResource SettingsActionButtonStyle}" />
                                        <Button
                                            x:Name="DeveloperAnnounceLoadButton"
                                            Grid.Column="2"
                                            Content="从仓库读取"
                                            Style="{StaticResource SettingsActionButtonStyle}" />
                                        <Button
                                            x:Name="DeveloperAnnouncePublishButton"
                                            Grid.Column="3"
                                            Content="发布到仓库"
                                            Style="{StaticResource SettingsAccentActionButtonStyle}" />
                                    </Grid>
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="公告发到主页。改完点「发布到仓库」，用户下次打开启动器就能看到。"
                                        Severity="Informational"
                                        Title="这里写的是给用户看的公告" />
                                    <ItemsRepeater
                                        x:Name="DeveloperAnnounceRepeater"
                                        ItemTemplate="{StaticResource DeveloperEntryTemplate}" />
                                </StackPanel>

                                <!-- 模块：权限（预留） -->
                                <StackPanel
                                    x:Name="DeveloperRolesPanel"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Style="{StaticResource SettingsRowTitleTextStyle}"
                                                Text="权限与角色" />
                                            <TextBlock
                                                Style="{StaticResource SettingsRowDescriptionTextStyle}"
                                                Text="以后放能提交推荐的账号名单。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <!-- 在线插件详情卡片 -->
        <ContentDialog
            x:Name="PluginDetailDialog"
            Grid.RowSpan="2"
            PrimaryButtonText=""
            SecondaryButtonText=""
            CloseButtonText="">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer
                MaxHeight="480"
                VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="PluginDetailTitle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="dsh-plugin-store"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PluginDetailAuthor"
                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                            Text="0xKcyzz · 0xKcyzz/dsh-plugin-store" />
                    </StackPanel>
                    <Button
                        x:Name="ClosePluginDetailButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="ClosePluginDetail_Click"
                        Style="{StaticResource SettingsIconButtonStyle}"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Spacing="12">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Stars 312" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="TypeScript" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="MIT" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="最近更新 2026-09-18" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="PluginDetailDescription"
                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                        Text="插件详情。"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="插件与依赖会以第三方代码的身份在 DSH 里运行，请确认来源可信后再安装。"
                        Severity="Informational"
                        Title="安装来自 GitHub 的第三方插件" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenPluginRepositoryButton"
                        Content="打开 GitHub 仓库"
                        Click="OpenPluginRepository_Click"
                        Style="{StaticResource SettingsActionButtonStyle}" />
                    <Button
                        x:Name="CopyPluginConfigButton"
                        Content="复制配置方式"
                        Click="CopyPluginConfig_Click"
                        Style="{StaticResource SettingsActionButtonStyle}" />
                    <Button
                        x:Name="InstallOnlinePluginButton"
                        Content="安装"
                        Click="InstallDetailPlugin_Click"
                        Style="{StaticResource SettingsAccentActionButtonStyle}" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </ContentDialog>

        <!-- 在线技能详情卡片 -->
        <ContentDialog
            x:Name="SkillDetailDialog"
            Grid.RowSpan="2"
            PrimaryButtonText=""
            SecondaryButtonText=""
            CloseButtonText="">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer
                MaxHeight="480"
                VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="SkillDetailTitle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="beautify-github-readme"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SkillDetailAuthor"
                            Style="{StaticResource SettingsRowDescriptionTextStyle}"
                            Text="oil-oil · oil-oil/beautify-github-readme" />
                    </StackPanel>
                    <Button
                        x:Name="CloseSkillDetailButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Click="CloseSkillDetail_Click"
                        Style="{StaticResource SettingsIconButtonStyle}"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Spacing="12">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailStarsText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Stars 0" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailCategoryText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="其他" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailLanguageText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="未标注" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailLicenseText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="未标注" />
                        </Border>
                        <Border Style="{StaticResource SettingsTagPillStyle}">
                            <TextBlock
                                x:Name="SkillDetailPushedText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="最近更新 -" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="SkillDetailDescription"
                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                        Text="技能简介。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SkillDetailPathText"
                        Style="{StaticResource SettingsRowDescriptionTextStyle}"
                        Text="技能目录：-" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="技能是给 Agent 看的指令，装上以后模型会照着它执行。请确认来源可信后再安装。"
                        Severity="Informational"
                        Title="安装来自 GitHub 的第三方技能" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenSkillRepositoryButton"
                        Content="打开 GitHub 仓库"
                        Click="OpenDetailSkillRepository_Click"
                        Style="{StaticResource SettingsActionButtonStyle}" />
                    <Button
                        x:Name="InstallDetailSkillButton"
                        Content="安装"
                        Click="InstallDetailSkill_Click"
                        Style="{StaticResource SettingsAccentActionButtonStyle}" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </ContentDialog>

        <!-- 公告编辑：开发者页新增 / 修改一条公告 -->
        <ContentDialog
            x:Name="AnnouncementEditDialog"
            Grid.RowSpan="2"
            DefaultButton="Primary"
            PrimaryButtonText="保存"
            SecondaryButtonText="取消"
            Title="公告">
            <StackPanel
                Width="440"
                Spacing="10">
                <TextBox
                    x:Name="AnnouncementTitleBox"
                    Header="标题"
                    PlaceholderText="一句话说清这次改了什么" />
                <TextBox
                    x:Name="AnnouncementBodyBox"
                    Height="120"
                    AcceptsReturn="True"
                    Header="正文"
                    PlaceholderText="发生了什么、影响谁、要做什么"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="AnnouncementTagBox"
                        HorizontalAlignment="Stretch"
                        Header="标签"
                        SelectedIndex="0">
                        <ComboBoxItem Content="更新" />
                        <ComboBoxItem Content="提醒" />
                        <ComboBoxItem Content="重要" />
                        <ComboBoxItem Content="活动" />
                        <ComboBoxItem Content="公告" />
                    </ComboBox>
                    <TextBox
                        x:Name="AnnouncementDateBox"
                        Grid.Column="1"
                        Header="日期"
                        PlaceholderText="2026-09-27" />
                    <CheckBox
                        x:Name="AnnouncementPinnedBox"
                        Grid.Column="2"
                        Margin="0,26,0,0"
                        Content="置顶" />
                </Grid>
                <TextBox
                    x:Name="AnnouncementUrlBox"
                    Header="详情链接（可空）"
                    PlaceholderText="https://github.com/..." />
            </StackPanel>
        </ContentDialog>

        <!-- 浮动的 GitHub Token 提示：目录接口被限流时出现 -->
        <Grid
            Grid.Row="1"
            Margin="12"
            VerticalAlignment="Bottom">
            <InfoBar
                x:Name="GitHubTokenPromptInfoBar"
                IsClosable="False"
                IsOpen="False"
                Message="您需要写入 GitHub Token 以获取更多内容。"
                Severity="Informational"
                Title="GitHub 接口配额已用完">
                <InfoBar.ActionButton>
                    <Button
                        Click="FillGitHubToken_Click"
                        Content="立即填写" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</Window>
