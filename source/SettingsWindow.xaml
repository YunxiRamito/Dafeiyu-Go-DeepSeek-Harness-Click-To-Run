                                            <ComboBoxItem Content="全部状态" Tag="All" /><ComboBoxItem Content="已提交" Tag="Submitted" /><ComboBoxItem Content="处理中" Tag="Processing" /><ComboBoxItem Content="已完成" Tag="Completed" /><ComboBoxItem Content="暂不处理" Tag="Deferred" />
                                        </ComboBox>
                                        <Button x:Name="DeveloperFeedbackRefreshButton" Grid.Column="2" Content="刷新" Click="DeveloperFeedbackRefresh_Click" Style="{StaticResource SettingsCompactButtonStyle}" />
                                    </Grid>
