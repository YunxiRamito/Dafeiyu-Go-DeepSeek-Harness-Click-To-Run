                                                            <Button x:Name="DeveloperNotificationMetricsButton" Grid.Column="1" Content="刷新指标" Click="DeveloperNotificationMetrics_Click" Style="{StaticResource SettingsActionButtonStyle}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="DeveloperAcknowledgementsPanel" Spacing="12" Visibility="Collapsed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SettingsRowTitleTextStyle}" Text="鸣谢名单管理" />
